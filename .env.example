# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Default matches the postgres service in docker-compose.yml

# Optional: expose PostgreSQL on this host port (e.g. for psql / DB tools).
# Leave unset to keep Postgres internal-only.
# POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://wiki:wiki@postgres:5432/wiki

# ── Storage backend (raw uploaded files only) ─────────────────────────────────
# Wiki pages, graph cache, and schema are stored exclusively in PostgreSQL.
# This setting controls where raw source uploads (PDFs, DOCXs, etc.) are stored.
#
# "local" (default): raw files stored under DATA_DIR on the container volume
# "s3"             : raw files stored in an AWS S3 bucket (DATA_BUCKET must be set)
STORAGE_BACKEND=local
DATA_DIR=/data

# Required only when STORAGE_BACKEND=s3
DATA_BUCKET=
# Optional: override the S3 endpoint (e.g. for MinIO). Leave blank for real AWS.
AWS_ENDPOINT_URL=

# ── LLM provider ──────────────────────────────────────────────────────────────
# Which backend serves every model call. All LLM connections are created in
# app/providers/<name>.py and reached through app/model.py — nothing else in the
# codebase talks to a model vendor directly, so switching providers is a config
# change for a registered adapter. Registered: bedrock, anthropic, openai.
LLM_PROVIDER=bedrock

# Direct Anthropic/OpenAI use LLM_API_KEY and an optional trusted LLM_BASE_URL.
# Bedrock uses AWS credentials below and ignores both fields, even if populated.
# Only LLM_PROVIDER selects the adapter; credentials never switch providers.
LLM_API_KEY=
LLM_BASE_URL=

# To use direct Anthropic: set LLM_PROVIDER=anthropic, supply LLM_API_KEY,
# use MODEL_DEFAULT=haiku45 and MODEL_EMBEDDING=.
# Remove unwanted text-role overrides before switching.
# AWS credentials are still needed for S3 storage, but not Anthropic model calls.
# To use OpenAI: set LLM_PROVIDER=openai, supply LLM_API_KEY,
# use MODEL_DEFAULT=gpt41mini and MODEL_EMBEDDING=embed3small (or blank).
# Remove incompatible text-role overrides. LLM_BASE_URL defaults to
# https://api.openai.com/v1; a custom gateway must implement the Responses API.

# Default for all text roles unless explicitly overridden below.
# Never used for embeddings. Blank required text models fail validation.
MODEL_DEFAULT=haiku45

# ── AWS Credentials ───────────────────────────────────────────────────────────
# Leave blank to use IAM instance role (recommended for EC2/ECS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: assume an IAM role instead of using static credentials
ASSUMED_ROLE_ARN=
ASSUMED_ROLE_SESSION_NAME=WikiAgentSession
ASSUMED_ROLE_DURATION=3600

# ── Models, one per logical role ──────────────────────────────────────────────
# Friendly names only. All IDs, provider mappings and capabilities live in
# app/model_catalog.yaml. Same-name provider switches require an explicit mapping;
# the app never substitutes a different model. Add custom IDs to the catalogue.
# Matching ignores case/punctuation: haiku45 = haiku-4.5 = "Haiku 4.5".
# Raw IDs/ARNs are not passed through. Unknown names and capability mismatches fail.
# Old BEDROCK_*_MODEL_ID keys are rejected even if blank; remove them from both
# .env and the process/container environment before upgrading.

# Role INGEST_PLAN — ingest planner (tool-calling reasoning loop).
# MODEL_INGEST_PLAN=haiku45
# Role INGEST_WRITE — page renderer inside the ingest pipeline (single-shot).
# MODEL_INGEST_WRITE=haiku45
# Role QUERY — chat / Q&A over the wiki.
# MODEL_QUERY=haiku45
# Role RECALIBRATE — wiki-wide analysis and rewrite.
MODEL_RECALIBRATE=sonnet45
# Role DRAFT_AGENT — conversational AI Writer agent (multi-turn — gathers
# requirements, drafts, revises). Inherits MODEL_DEFAULT, not MODEL_QUERY.
# MODEL_DRAFT_AGENT=haiku45
# Role EDIT — inline AI editor; rewrites a whole page or one section
# against an instruction (single-shot).
MODEL_EDIT=sonnet45

# The two active overrides above preserve this example's stronger edit/recalibrate
# choices. Comment them out too if every text role should use MODEL_DEFAULT.
# After changing settings: python -m app.check_models
# Explicit live checks (may incur charges): python -m app.check_models --live --yes

# Bedrock profile geography: must appear in the selected model's inference_geos
# in app/model_catalog.yaml. Becomes the prefix, such as us.anthropic.claude-...
# Leave blank to call foundation models directly with no inference profile.
BEDROCK_INFERENCE_GEO=us

# ── Semantic embeddings (optional) — Role EMBEDDING ──────────────────
# Leave blank to disable vector search (BM25-only search is used instead).
# Requires the pgvector extension in PostgreSQL (included in docker-compose).
# Use titanembedv1 for vector(1536); verified with a live Bedrock request.
# Cohere V4 selection is blocked until the adapter supports its response format.
# Direct OpenAI: embed3small or embed3large (both configured for 1536 dimensions).
# Direct Anthropic: leave embeddings blank.
# Titan V2 / Cohere V3 need a storage migration; changing dimensions is not enough.
# After changing models, existing pages use keyword search until rewritten/re-ingested.
# Embedding models are plain foundation models — BEDROCK_INFERENCE_GEO does
# not apply to them.
MODEL_EMBEDDING=
EMBEDDING_DIMENSIONS=1536

# Set to false to disable TLS certificate verification on all Bedrock model
# clients (chat, converse, embeddings). Only needed behind a TLS-intercepting
# proxy with a self-signed CA. Keep true in production.
BEDROCK_SSL_VERIFY=true

# ── App ───────────────────────────────────────────────────────────────────────
# "development" (default) or "production". When set to "production", the app
# refuses to start if JWT_SECRET or AUTH_PASSWORD are left at their defaults.
ENVIRONMENT=development
APP_TITLE=AI Knowledge Hub
APP_PORT=8000
APP_TIMEZONE=UTC
COMPANY_NAME=My Company
# DEBUG for verbose output, WARNING to reduce noise
LOG_LEVEL=INFO
CHAT_STREAM=true
MAX_UPLOAD_SIZE_MB=2

# ── Docker image registry ────────────────────────────────────────────────────
# Optional: prefix for built image names (include trailing slash).
# Leave unset to use plain names (e.g. llm-wiki-app:latest).
# IMAGE_PREFIX=docker.abc.com/

# ── Auth ──────────────────────────────────────────────────────────────────────
# Seed credentials for the default org's admin user (created on first boot only).
# Change these before deploying — with ENVIRONMENT=production the app refuses to
# start while AUTH_PASSWORD is left at "admin"/"changeme".
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Secret used to sign JWT access/refresh tokens. Generate a strong random value
# (e.g. `openssl rand -hex 32`). With ENVIRONMENT=production the app refuses to
# start while this is left at the default.
JWT_SECRET=change-me-in-production

# ── Admin Dashboard + User Permission System ─────────────────────────
# No additional environment variables required for Admin Dashboard.
# All configuration is managed at runtime via the admin dashboard at /admin.
#
# Key features configured through the admin UI (stored in PostgreSQL):
#   - Permission templates: define per-feature flags + upload/token quotas
#   - User management: assign templates, suspend users, reset passwords
#   - Workspaces: isolated S3 prefix environments per user/team
#   - Org-level limits: max uploads/day, max tokens/day, max members
#   - Usage reports and audit log browsing
